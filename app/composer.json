{

  "require" : {
    "php": ">=8.5.6",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.8",
    "ramsey/uuid": "^4.9",
    "php-di/php-di": "^7.1",
    "php-di/slim-bridge": "^3.4",
    "respect/validation": "^3.0",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "phpstan/phpstan": "^2.2",
    "pestphp/pest": "^4.7",
    "spatie/phpunit-watcher": "^1.24"
  },
  "autoload": {
    "psr-4" : {
      "toubilib\\" : "./src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "tests/"
    }
},
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
